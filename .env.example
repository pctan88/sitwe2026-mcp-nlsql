# ============================================================
# SITWE 2026 — API key template
# Copy this file to .env and fill in your real keys.
# .env is gitignored and must NEVER be committed.
# ============================================================

# Anthropic — required for Claude Haiku 4.5 (canonical paper backend)
# https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google — required for Gemini 2.5 Flash
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza-your-key-here
GEMINI_API_KEY=AIza-your-key-here

# OpenAI — required for GPT-4o (cross-model Table V)
# https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-key-here

# Together AI — required for Llama 3.3 70B (OpenAI-compatible endpoint)
# https://api.together.xyz/settings/api-keys
OPENAI_COMPAT_BASE_URL=https://api.together.xyz/v1
OPENAI_COMPAT_API_KEY=your-together-ai-key-here

# xAI — only needed if re-running Grok experiments (not in final paper)
# https://console.x.ai/
XAI_API_KEY=xai-your-key-here

# Napkin AI — only needed for diagram generation (not part of evaluation)
# https://www.napkin.ai/
NAPKIN_API_KEY=your-napkin-key-here
NAPKIN_API_URL=https://api.napkin.ai/api/create-visual-request
